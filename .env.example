# Environment variables for mydownloader.
# Set in Render dashboard → Environment (jangan pernah commit nilai asli).

# HMAC secret untuk signed download URLs (/file/<token>/<name>).
# WAJIB di-set di production supaya token stabil antar restart.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# TTL token unduhan (detik). Default 3600 = 1 jam.
# FILE_TOKEN_TTL=3600

# Rate limit per-IP. Default: 10 request / 60 detik untuk /api/download/start
# dan /api/metadata. Naikkan kalau trafik organik lebih tinggi.
# RATE_LIMIT_MAX=10
# RATE_LIMIT_WINDOW=60

# TTL job sebelum janitor hapus (detik). Default 1800 = 30 menit.
# JOB_TTL=1800

# Direktori file download & path cookies (override untuk test).
# DOWNLOADS_DIR=/tmp/downloads
# COOKIES_PATH=/tmp/cookies.txt
